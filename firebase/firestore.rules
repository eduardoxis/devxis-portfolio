rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function signedIn(){return request.auth != null;}
 function admin(){return signedIn() && request.auth.token.admin == true;}
 match /projects/{id}{allow get,list: if resource.data.publicado == true || admin();allow create,update,delete: if admin();}
 match /testimonials/{id}{allow get,list: if resource.data.publicado == true || admin();allow create,update,delete: if admin();}
 match /technologies/{id}{allow get,list: if resource.data.publicado == true || admin();allow create,update,delete: if admin();}
 match /profile/{id}{allow get: if true;allow create,update,delete: if admin();}
 match /settings/{id}{allow get: if true;allow create,update,delete: if admin();}
 match /quotes/{id}{allow create: if request.resource.data.keys().hasAll(['nome','email','whatsapp','tipoSistema','faixaOrcamento','descricao','status','criadoEm']) && request.resource.data.nome is string && request.resource.data.nome.size()<=100 && request.resource.data.email is string && request.resource.data.descricao is string && request.resource.data.descricao.size()<=3000 && request.resource.data.status=='novo';allow get,list,update,delete: if admin();}
 match /users/{id}{allow get: if signedIn() && (request.auth.uid==id || admin());allow write: if admin();}
}}
